"c::CTRL-P": { "mode": "c", "keybind": "CTRL-P", "description": "after using 'wildchar' with multiple matches: go to previous match, otherwise: recall older command-line from history." },
"c::CTRL-Q": { "mode": "c", "keybind": "CTRL-Q", "description": "same as CTRL-V, unless it's used for terminal control flow" },
"c::CTRL-T": { "mode": "c", "keybind": "CTRL-T", "description": "previous match when 'incsearch' is active" },
"c::CTRL-U": { "mode": "c", "keybind": "CTRL-U", "description": "remove all characters between the cursor and beginning of command-line" },
"c::CTRL-V": { "mode": "c", "keybind": "CTRL-V", "description": "insert next non-digit literally, insert three digit decimal number as a single byte." },
"c::CTRL-W": { "mode": "c", "keybind": "CTRL-W", "description": "delete the word in front of the cursor" },
"c::CTRL-]": { "mode": "c", "keybind": "CTRL-]", "description": "trigger abbreviation" },
"c::CTRL-^": { "mode": "c", "keybind": "CTRL-^", "description": "toggle use of |:lmap| mappings" },
"c::<Del>": { "mode": "c", "keybind": "<Del>", "description": "delete the character under the cursor" },

"c::<Left>": { "mode": "c", "keybind": "<Left>", "description": "cursor left" },
"c::<S-Left>": { "mode": "c", "keybind": "<S-Left>", "description": "cursor one word left" },
"c::<C-Left>": { "mode": "c", "keybind": "<C-Left>", "description": "cursor one word left" },
"c::<Right>": { "mode": "c", "keybind": "<Right>", "description": "cursor right" },
"c::<S-Right>": { "mode": "c", "keybind": "<S-Right>", "description": "cursor one word right" },
"c::<C-Right>": { "mode": "c", "keybind": "<C-Right>", "description": "cursor one word right" },
"c::<Up>": { "mode": "c", "keybind": "<Up>", "description": "recall previous command-line from history that matches pattern in front of the cursor" },
"c::<S-Up>": { "mode": "c", "keybind": "<S-Up>", "description": "recall previous command-line from history" },
"c::<Down>": { "mode": "c", "keybind": "<Down>", "description": "recall next command-line from history that matches pattern in front of the cursor" },
"c::<S-Down>": { "mode": "c", "keybind": "<S-Down>", "description": "recall next command-line from history" },
"c::<Home>": { "mode": "c", "keybind": "<Home>", "description": "cursor to start of command-line" },
"c::<End>": { "mode": "c", "keybind": "<End>", "description": "cursor to end of command-line" },
"c::<PageDown>": { "mode": "c", "keybind": "<PageDown>", "description": "same as <S-Down>" },
"c::<PageUp>": { "mode": "c", "keybind": "<PageUp>", "description": "same as <S-Up>" },
"c::<Insert>": { "mode": "c", "keybind": "<Insert>", "description": "toggle insert/overstrike mode" },
"c::<LeftMouse>": { "mode": "c", "keybind": "<LeftMouse>", "description": "cursor at mouse click" },
"v::a'": { "mode": "v", "keybind": "a'", "description": "   single quoted string" },
"": {}


}